# Run scripts/configure-free-cloud.mjs to generate independent secrets.
POSTGRES_PASSWORD=GENERATE
DBL_MIGRATOR_PASSWORD=GENERATE
DBL_APP_PASSWORD=GENERATE
DBL_WORKER_PASSWORD=GENERATE
KC_DB_PASSWORD=GENERATE
KC_BOOTSTRAP_ADMIN_PASSWORD=GENERATE
OWNER_INITIAL_PASSWORD=GENERATE
KC_STAFF_CLIENT_SECRET=GENERATE
KC_PORTAL_CLIENT_SECRET=GENERATE
STAFF_SESSION_SECRET=GENERATE
PORTAL_SESSION_SECRET=GENERATE
REDIS_PASSWORD=GENERATE
ADMIN_DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@postgres:5432/dbl
MIGRATION_DATABASE_URL=postgresql://dbl_migrator:${DBL_MIGRATOR_PASSWORD}@postgres:5432/dbl
APP_DATABASE_URL=postgresql://dbl_app:${DBL_APP_PASSWORD}@postgres:5432/dbl
WORKER_DATABASE_URL=postgresql://dbl_worker:${DBL_WORKER_PASSWORD}@postgres:5432/dbl
STAFF_URL=https://logistics.example.com
PORTAL_URL=https://portal.example.com
IDENTITY_URL=https://auth.example.com
KC_BOOTSTRAP_ADMIN_USERNAME=admin
OWNER_USERNAME=owner
OWNER_EMAIL=owner@example.com
TENANT_SLUG=digitalburj
TENANT_NAME=DigitalBurj Logistics
TUNNEL_TOKEN=REPLACE_WITH_CLOUDFLARE_TUNNEL_TOKEN
# Start with uploads disabled; set false only after storage and scanner acceptance.
RAILWAY_FREE_PILOT=true
DOCUMENT_BUCKET=dbl-documents
S3_ENDPOINT=https://PROJECT_REF.storage.supabase.co/storage/v1/s3
AWS_REGION=REPLACE_WITH_SUPABASE_REGION
AWS_ACCESS_KEY_ID=REPLACE_WITH_S3_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_S3_SECRET_KEY
S3_FORCE_PATH_STYLE=true
S3_SERVER_SIDE_ENCRYPTION=none
SMTP_URL=
SMTP_FROM=
# Only required by compose.supabase.yaml; use custom-role session pooler URLs.
SUPABASE_ADMIN_DATABASE_URL=
SUPABASE_MIGRATION_DATABASE_URL=
SUPABASE_APP_DATABASE_URL=
SUPABASE_WORKER_DATABASE_URL=
