# ---- server (API) ----
DATABASE_URL=postgres://dbl_app:dbl_app_dev@localhost:54329/dbl            # runtime role: NOT superuser, NOT BYPASSRLS
MIGRATION_DATABASE_URL=postgres://dbl_migrator:dbl_migrator_dev@localhost:54329/dbl
WORKER_DATABASE_URL=postgres://dbl_worker:dbl_worker_dev@localhost:54329/dbl
REDIS_URL=redis://localhost:6379
OIDC_ISSUER_URL=http://localhost:8080/realms/dbl      # production REQUIRES this; DEV_AUTH_SECRET is refused when NODE_ENV=production
OIDC_AUDIENCE=dbl-api
DEV_AUTH_SECRET=dev-secret-dev-secret-dev-secret-00   # local development only
DOCUMENT_BUCKET=dbl-documents-dev
S3_ENDPOINT=http://localhost:9000
# Webhook secrets are referenced from integ.connections.webhook_secret_ref and resolved from the secrets manager (env SECRET_<REF> in dev)
# ---- session gateway (staff-web / partner-portal; server-only, never NEXT_PUBLIC_) ----
API_BASE_URL=http://localhost:3001
SESSION_SECRET=change-me-change-me-change-me-change-me
OIDC_WEB_CLIENT_ID=dbl-staff-web
OIDC_WEB_CLIENT_SECRET=dev-secret
OIDC_REDIRECT_URI=http://localhost:3000/api/auth/callback
# ---- worker: document safety & extraction (all free / open-source engines) ----
CLAMD_HOST=localhost                    # ClamAV clamd (INSTREAM). Or CLAMD_SOCKET=/var/run/clamav/clamd.ctl. Without it the worker fails closed: documents stay unusable.
CLAMD_PORT=3310
OCR_LANGS=eng+ara                       # Tesseract languages (needs the traineddata packages installed)
# ---- worker: customer messaging ----
SMTP_URL=smtp://localhost:1025          # production: smtps://user:pass@smtp.office365.com:587 (Microsoft 365) or any SMTP relay
SMTP_FROM="DigitalBurj Logistics <noreply@example.com>"
SMTP_REPLY_TO=
PORTAL_BASE_URL=http://localhost:3002   # links inside messages
WHATSAPP_TOKEN=                         # WhatsApp Cloud API permanent token (secret store in production)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_LANG=en
